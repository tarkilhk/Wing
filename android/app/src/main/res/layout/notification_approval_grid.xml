<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/notice_title" android:maxLines="1" android:ellipsize="end" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/notification_ink" />
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/notice_pending" android:maxLines="1" android:ellipsize="end" android:textSize="14sp" android:textColor="@color/notification_secondary" android:paddingTop="4dp" />
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/notice_command" android:maxLines="1" android:ellipsize="end" android:textSize="15sp" android:fontFamily="monospace" android:textColor="@color/notification_ink" android:paddingTop="10dp" android:paddingBottom="8dp" />
 <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:baselineAligned="false"><Button android:id="@+id/once" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="✓ Once" android:contentDescription="Allow this request once" android:gravity="center" android:textSize="14sp" android:textColor="@color/notification_action" android:background="?android:attr/selectableItemBackground" android:textAllCaps="false" android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp" />
  <Button android:id="@+id/session" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="✓ Session" android:contentDescription="Allow the matching pattern for this session" android:gravity="center" android:textSize="14sp" android:textColor="@color/notification_action" android:background="?android:attr/selectableItemBackground" android:textAllCaps="false" android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp" />
  </LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:baselineAligned="false"><Button android:id="@+id/always" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="✓ Always…" android:contentDescription="Review permanent approval of the matching pattern" android:gravity="center" android:textSize="14sp" android:textColor="@color/notification_action" android:background="?android:attr/selectableItemBackground" android:textAllCaps="false" android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp" />
  <Button android:id="@+id/deny" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="✕ Deny" android:contentDescription="Deny this request" android:gravity="center" android:textSize="14sp" android:textColor="@color/notification_deny" android:background="?android:attr/selectableItemBackground" android:textAllCaps="false" android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp" />
 </LinearLayout></LinearLayout>