<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/notice_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/notification_ink" />
    <TextView android:id="@+id/notice_pending" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textSize="14sp" android:textColor="@color/notification_secondary" android:paddingTop="4dp" />
    <TextView android:id="@+id/notice_command" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textSize="15sp" android:fontFamily="monospace" android:textColor="@color/notification_ink" android:paddingTop="10dp" android:paddingBottom="8dp" />
    <TextView android:id="@+id/notice_scope" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Session allows matching commands for this session." android:textSize="12sp" android:textColor="@color/notification_secondary" android:paddingBottom="4dp" />
    <LinearLayout android:id="@+id/review_actions" android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:baselineAligned="false" android:visibility="gone">
        <ImageButton android:id="@+id/review" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:contentDescription="Review the full command" android:background="?android:attr/selectableItemBackground" android:padding="12dp" android:minWidth="0dp" android:minHeight="0dp" android:src="@drawable/ic_notice_review" />
        <ImageButton android:id="@+id/review_deny" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:contentDescription="Deny this request" android:background="?android:attr/selectableItemBackground" android:padding="12dp" android:minWidth="0dp" android:minHeight="0dp" android:src="@drawable/ic_notice_deny" />
    </LinearLayout>
    <LinearLayout android:id="@+id/approval_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:baselineAligned="false">
        <ImageButton android:id="@+id/once" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:contentDescription="Allow this request once" android:background="?android:attr/selectableItemBackground" android:padding="12dp" android:minWidth="0dp" android:minHeight="0dp" android:src="@drawable/ic_notice_once" />
        <ImageButton android:id="@+id/session" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:contentDescription="Allow matching commands for this session" android:background="?android:attr/selectableItemBackground" android:padding="12dp" android:minWidth="0dp" android:minHeight="0dp" android:src="@drawable/ic_notice_session" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:baselineAligned="false">
        <ImageButton android:id="@+id/always" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:contentDescription="Review permanent approval of matching commands" android:background="?android:attr/selectableItemBackground" android:padding="12dp" android:minWidth="0dp" android:minHeight="0dp" android:src="@drawable/ic_notice_always" />
        <ImageButton android:id="@+id/deny" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:contentDescription="Deny this request" android:background="?android:attr/selectableItemBackground" android:padding="12dp" android:minWidth="0dp" android:minHeight="0dp" android:src="@drawable/ic_notice_deny" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
