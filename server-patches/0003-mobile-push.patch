@@ -0,0 +1,50 @@
+"""Authenticated dashboard routes for Android push registration."""
+
+from pathlib import Path
+from typing import Any
+
+from fastapi import APIRouter, HTTPException, Response
+
+from hermes_cli.mobile_push import register, remove, sender_status
+from hermes_cli.web_deps import late
+
+router = APIRouter()
+_profile_scope = late("_profile_scope", "hermes_cli.web_server_profiles")
+
+
+def _scope(profile: str) -> tuple[Path, Path, str]:
+    from hermes_cli.config import get_process_hermes_home
+    from hermes_constants import get_hermes_home, profile_name_for_home
+    home = Path(get_hermes_home())
+    canonical = profile_name_for_home(home) or profile
+    return home, Path(get_process_hermes_home()), canonical
+
+
+@router.get("/api/mobile/push/status")
+def mobile_push_status(profile: str):
+    with _profile_scope(profile):
+        _, config_home, _ = _scope(profile)
+        return sender_status(config_home)
+
+
+@router.post("/api/mobile/push/installations")
+def mobile_push_register(body: dict[str, Any], profile: str):
+    try:
+        with _profile_scope(profile):
+            home, config_home, canonical = _scope(profile)
+            return register(home, canonical, body, config_home=config_home)
+    except ValueError as exc:
+        raise HTTPException(status_code=400, detail=str(exc)) from exc
+    except RuntimeError as exc:
+        raise HTTPException(status_code=503, detail=f"Mobile push is not configured: {exc}") from exc
+
+
+@router.delete("/api/mobile/push/installations/{registration_id}", status_code=204)
+def mobile_push_remove(registration_id: str, profile: str):
+    try:
+        with _profile_scope(profile):
+            home, _, canonical = _scope(profile)
+            remove(home, canonical, registration_id)
+    except ValueError as exc:
+        raise HTTPException(status_code=400, detail=str(exc)) from exc
+    return Response(status_code=204)
