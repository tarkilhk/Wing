@@ -0,0 +1,49 @@
+from contextlib import nullcontext
+
+from fastapi.testclient import TestClient
+
+from hermes_cli import web_server
+from hermes_cli.web_routers import mobile_push as routes
+
+
+def _client():
+    return TestClient(web_server.app, base_url="http://127.0.0.1:8080")
+
+
+def _headers():
+    return {web_server._SESSION_HEADER_NAME: web_server._SESSION_TOKEN}
+
+
+def test_mobile_push_status_requires_dashboard_auth(monkeypatch, tmp_path):
+    monkeypatch.setattr(routes, "_profile_scope", lambda _profile: nullcontext())
+    monkeypatch.setattr(routes, "_scope", lambda profile: (tmp_path, tmp_path, profile))
+    monkeypatch.setattr(routes, "sender_status", lambda _home: {
+        "available": True, "configured": False, "reason": "disabled"})
+    with _client() as client:
+        assert client.get("/api/mobile/push/status?profile=work").status_code == 401
+        response = client.get("/api/mobile/push/status?profile=work", headers=_headers())
+    assert response.status_code == 200
+    assert response.json() == {"available": True, "configured": False, "reason": "disabled"}
+
+
+def test_mobile_push_registration_and_idempotent_delete(monkeypatch, tmp_path):
+    calls = []
+    monkeypatch.setattr(routes, "_profile_scope", lambda _profile: nullcontext())
+    monkeypatch.setattr(routes, "_scope", lambda profile: (tmp_path, tmp_path, profile))
+    monkeypatch.setattr(routes, "register", lambda home, profile, body, config_home: {
+        "registration_id": "reg-1", "installation_id": body["installation_id"],
+        "workspace": body["workspace"], "preferences": body["preferences"], "updated_at": 1})
+    monkeypatch.setattr(routes, "remove", lambda home, profile, registration_id: calls.append(
+        (home, profile, registration_id)))
+    body = {
+        "installation_id": "install-1",
+        "workspace": {"connection": "saved", "connection_identity": "host", "profile": "work"},
+        "preferences": {"completion": True, "attention": True, "include_chat_title": False},
+    }
+    with _client() as client:
+        response = client.post("/api/mobile/push/installations?profile=work", json=body, headers=_headers())
+        deleted = client.delete("/api/mobile/push/installations/reg-1?profile=work", headers=_headers())
+    assert response.status_code == 200
+    assert response.json()["registration_id"] == "reg-1"
+    assert deleted.status_code == 204 and deleted.content == b""
+    assert calls == [(tmp_path, "work", "reg-1")]
