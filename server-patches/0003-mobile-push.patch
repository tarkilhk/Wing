@@ -0,0 +1,211 @@
+import json
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+from hermes_cli import mobile_push
+
+
+CONFIG = {
+    "enabled": True,
+    "firebase_project_id": "test-project",
+    "allowed_application_ids": ["com.tarkilhk.wing"],
+}
+
+
+def body(token="token-one"):
+    return {
+        "schema_version": 1,
+        "installation_id": "96f8869a-9212-4779-b0f0-b383b868d872",
+        "fcm_token": token,
+        "platform": "android",
+        "application_id": "com.tarkilhk.wing",
+        "workspace": {"connection": "saved-1", "connection_identity": "host-key", "profile": "work"},
+        "preferences": {"completion": True, "attention": True, "include_chat_title": False},
+    }
+
+
+class MobilePushRegistrationTest(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.home = Path(self.temp.name)
+
+    def tearDown(self):
+        self.temp.cleanup()
+
+    @patch.object(mobile_push, "sender_status", return_value={"configured": True})
+    @patch.object(mobile_push, "_configuration", return_value=CONFIG)
+    def test_registration_upserts_token_without_changing_id(self, _config, _status):
+        first = mobile_push.register(self.home, "work", body())
+        second = mobile_push.register(self.home, "work", body("token-two"))
+        self.assertEqual(first["registration_id"], second["registration_id"])
+        self.assertNotIn("fcm_token", second)
+        with mobile_push._database(self.home) as db:
+            rows = db.execute("SELECT fcm_token FROM registrations").fetchall()
+        self.assertEqual([row["fcm_token"] for row in rows], ["token-two"])
+
+    @patch.object(mobile_push, "sender_status", return_value={"configured": True})
+    @patch.object(mobile_push, "_configuration", return_value=CONFIG)
+    def test_workspace_profile_must_match_query(self, _config, _status):
+        with self.assertRaisesRegex(ValueError, "must match"):
+            mobile_push.register(self.home, "personal", body())
+
+    def test_only_explicit_unregistered_error_prunes_token(self):
+        unregistered = type("Response", (), {"json": lambda self: {
+            "error": {"status": "NOT_FOUND", "details": [{"errorCode": "UNREGISTERED"}]}}})()
+        invalid = type("Response", (), {"json": lambda self: {
+            "error": {"status": "INVALID_ARGUMENT", "details": []}}})()
+        self.assertTrue(mobile_push._is_unregistered(unregistered))
