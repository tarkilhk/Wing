index 0000000..057b510
--- /dev/null
+++ b/hermes_cli/mobile_push.py
@@ -0,0 +1,425 @@
+"""Profile-scoped Android push registrations and a bounded Firebase sender."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import logging
+import os
+import queue
+import sqlite3
+import threading
+import time
+import uuid
+from contextlib import contextmanager
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, Callable
+
+import httpx
+
+log = logging.getLogger(__name__)
+
+_DB_NAME = "mobile_push.db"
+_MAX_TOKEN = 4096
+_MAX_ID = 255
+_DEFAULT_MAX_AGE_DAYS = 90
+_PROCESS_NONCE = uuid.uuid4().hex
+_EVENT_TYPES = {
+    "message.complete": "completion",
+    "background.complete": "completion",
+    "btw.complete": "completion",
+    "preview.restart.complete": "completion",
+    "approval.request": "input_required",
+    "clarify.request": "input_required",
+    "sudo.request": "input_required",
+    "secret.request": "input_required",
+    "vault.unlock.request": "input_required",
+    "vault.save_login.request": "input_required",
+    "vault.code.request": "input_required",
+}
+
+
+def stamp_event_id(params: dict) -> str | None:
+    """Add one opaque ID to eligible WS payloads and return it for FCM reuse."""
+    event = str(params.get("type") or "")
+    if event not in _EVENT_TYPES:
+        return None
+    payload = params.get("payload")
+    if not isinstance(payload, dict):
+        payload = {}
+        params["payload"] = payload
+    existing = str(payload.get("mobile_push_event_id") or "").strip()
+    if existing:
+        return existing
+    value = hashlib.sha256(
+        f"{_PROCESS_NONCE}:{params.get('session_id')}:{params.get('seq')}:{event}".encode()
+    ).hexdigest()[:32]
+    payload["mobile_push_event_id"] = value
+    return value
+
+
+def _text(value: Any, name: str, maximum: int = _MAX_ID) -> str:
+    value = str(value or "").strip()
+    if not value or len(value) > maximum or "\x00" in value:
+        raise ValueError(f"{name} must be 1-{maximum} characters")
+    return value
+
+
+def _configuration(home: Path) -> dict:
+    config = {
+        "enabled": False,
+        "firebase_project_id": "",
+        "allowed_application_ids": ["com.tarkilhk.wing"],
+        "registration_max_age_days": _DEFAULT_MAX_AGE_DAYS,
+    }
+    try:
+        from hermes_cli.config import read_user_config_raw
+        raw = read_user_config_raw(home / "config.yaml")
+    except Exception:
+        raw = {}
+    value = raw.get("mobile_push") if isinstance(raw, dict) else None
+    if isinstance(value, dict):
+        config.update(value)
+    return config
+
+
+def _credentials(config: dict):
+    scopes = ["https://www.googleapis.com/auth/firebase.messaging"]
+    import google.auth
+    credentials, _ = google.auth.default(scopes=scopes, project=config.get("firebase_project_id"))
+    return credentials
+
+
+def sender_status(home: Path, *, credential_loader: Callable[[dict], Any] = _credentials) -> dict:
+    config = _configuration(home)
+    if not config.get("enabled"):
+        return {"available": True, "configured": False, "reason": "disabled"}
+    if not str(config.get("firebase_project_id") or "").strip():
+        return {"available": True, "configured": False, "reason": "missing_project_id"}
+    allowed = config.get("allowed_application_ids")
+    if not isinstance(allowed, list) or not [item for item in allowed if str(item).strip()]:
+        return {"available": True, "configured": False, "reason": "missing_application_allowlist"}
+    try:
+        credential_loader(config)
+    except ImportError:
+        return {"available": True, "configured": False, "reason": "missing_google_auth"}
+    except Exception:
+        return {"available": True, "configured": False, "reason": "missing_credentials"}
+    return {"available": True, "configured": True, "reason": None}
+
+
+def _connect(home: Path) -> sqlite3.Connection:
+    home.mkdir(parents=True, exist_ok=True)
+    db = sqlite3.connect(home / _DB_NAME, timeout=5)
+    db.row_factory = sqlite3.Row
+    db.execute("PRAGMA busy_timeout=5000")
+    db.execute("""
+        CREATE TABLE IF NOT EXISTS registrations (
+          registration_id TEXT PRIMARY KEY,
+          profile TEXT NOT NULL,
+          installation_id TEXT NOT NULL,
+          fcm_token TEXT NOT NULL,
+          platform TEXT NOT NULL,
+          application_id TEXT NOT NULL,
+          connection TEXT NOT NULL,
+          connection_identity TEXT NOT NULL,
+          completion INTEGER NOT NULL,
+          attention INTEGER NOT NULL,
+          include_chat_title INTEGER NOT NULL,
+          updated_at INTEGER NOT NULL,
+          UNIQUE(profile, installation_id, connection_identity)
+        )
+    """)
+    try:
+        os.chmod(home / _DB_NAME, 0o600)
+    except OSError:
+        pass
+    return db
+
+
+@contextmanager
+def _database(home: Path):
+    db = _connect(home)
+    try:
+        with db:
+            yield db
+    finally:
+        db.close()
+
+
+def register(home: Path, profile: str, body: dict, *, config_home: Path | None = None) -> dict:
+    config_home = config_home or home
+    config = _configuration(config_home)
+    status = sender_status(config_home)
+    if not status["configured"]:
+        raise RuntimeError(status["reason"])
+    if body.get("schema_version") != 1:
+        raise ValueError("schema_version must be 1")
+    installation_id = _text(body.get("installation_id"), "installation_id")
+    try:
+        uuid.UUID(installation_id)
+    except ValueError as exc:
+        raise ValueError("installation_id must be a UUID") from exc
+    token = _text(body.get("fcm_token"), "fcm_token", _MAX_TOKEN)
+    platform = _text(body.get("platform"), "platform", 32)
+    if platform != "android":
+        raise ValueError("platform must be android")
+    application_id = _text(body.get("application_id"), "application_id")
+    allowed = {str(item).strip() for item in config.get("allowed_application_ids", [])}
+    if application_id not in allowed:
+        raise ValueError("application_id is not allowed")
+    workspace = body.get("workspace")
+    if not isinstance(workspace, dict):
+        raise ValueError("workspace must be an object")
+    connection = _text(workspace.get("connection"), "workspace.connection")
+    identity = _text(workspace.get("connection_identity"), "workspace.connection_identity")
+    workspace_profile = _text(workspace.get("profile"), "workspace.profile")
+    if workspace_profile != profile:
+        raise ValueError("workspace.profile must match the requested profile")
+    preferences = body.get("preferences")
+    if not isinstance(preferences, dict):
+        raise ValueError("preferences must be an object")
+    expected = {"completion", "attention", "include_chat_title"}
+    if set(preferences) != expected or any(type(preferences[key]) is not bool for key in expected):
+        raise ValueError("preferences must contain completion, attention, and include_chat_title booleans")
+    now = int(time.time())
+    with _database(home) as db:
+        row = db.execute(
+            "SELECT registration_id FROM registrations WHERE profile=? AND installation_id=? AND connection_identity=?",
+            (profile, installation_id, identity),
+        ).fetchone()
+        registration_id = row["registration_id"] if row else uuid.uuid4().hex
+        db.execute("""
+            INSERT INTO registrations VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
+            ON CONFLICT(profile, installation_id, connection_identity) DO UPDATE SET
+              fcm_token=excluded.fcm_token, platform=excluded.platform,
+              application_id=excluded.application_id, connection=excluded.connection,
+              completion=excluded.completion, attention=excluded.attention,
+              include_chat_title=excluded.include_chat_title, updated_at=excluded.updated_at
+        """, (registration_id, profile, installation_id, token, platform, application_id,
+              connection, identity, int(preferences["completion"]), int(preferences["attention"]),
+              int(preferences["include_chat_title"]), now))
+    return {
+        "registration_id": registration_id,
+        "installation_id": installation_id,
+        "workspace": {"connection": connection, "connection_identity": identity, "profile": profile},
+        "preferences": preferences,
+        "updated_at": now,
+    }
+
+
+def remove(home: Path, profile: str, registration_id: str) -> None:
+    registration_id = _text(registration_id, "registration_id")
+    with _database(home) as db:
+        db.execute("DELETE FROM registrations WHERE registration_id=? AND profile=?", (registration_id, profile))
+
+
+def _registrations(home: Path, config_home: Path, profile: str, event_type: str) -> list[sqlite3.Row]:
+    config = _configuration(config_home)
+    max_age = max(1, int(config.get("registration_max_age_days") or _DEFAULT_MAX_AGE_DAYS))
+    cutoff = int(time.time()) - max_age * 86400
+    enabled_column = "completion" if event_type == "completion" else "attention"
+    with _database(home) as db:
+        db.execute("DELETE FROM registrations WHERE updated_at < ?", (cutoff,))
+        return db.execute(
+            f"SELECT * FROM registrations WHERE profile=? AND {enabled_column}=1", (profile,)
+        ).fetchall()
+
+
+def _is_unregistered(response: httpx.Response) -> bool:
+    try:
+        details = response.json().get("error", {}).get("details", [])
+    except Exception:
+        return False
+    return any(isinstance(item, dict) and item.get("errorCode") == "UNREGISTERED" for item in details)
+
+
+def _session_title(home: Path, session_id: str) -> str:
+    try:
+        from hermes_state import SessionDB
+        with SessionDB(db_path=home / "state.db", read_only=True) as db:
+            return str(db.get_session_title(session_id) or "").strip()[:80]
+    except Exception:
+        return ""
+
+
+@dataclass(frozen=True)
+class _Send:
+    home: Path
+    config_home: Path
+    registration_id: str
+    token: str
+    project_id: str
+    message: dict
+    event_id: str
+    event_type: str
+    chat_title: str
+
+
+@dataclass(frozen=True)
+class _Event:
+    home: Path
+    config_home: Path
+    profile: str
+    session_id: str
+    params: dict
+    title: str
+
+
+class Dispatcher:
+    def __init__(self, *, client_factory=httpx.Client, credential_loader=_credentials, max_queue: int = 256):
+        self._client_factory = client_factory
+        self._credential_loader = credential_loader
+        self._queue: queue.Queue[_Event] = queue.Queue(maxsize=max_queue)
+        self._seen: dict[tuple[str, str], float] = {}
+        self._lock = threading.Lock()
+        self._worker: threading.Thread | None = None
+
+    def enqueue_event(self, home: Path, config_home: Path, profile: str, session_id: str,
+                      params: dict, title: str = "") -> None:
+        if str(params.get("type") or "") not in _EVENT_TYPES:
+            return
+        event = _Event(home, config_home, profile, session_id,
+                       {**params, "payload": dict(params.get("payload") or {})}, title)
+        try:
+            self._queue.put_nowait(event)
+        except queue.Full:
+            log.warning("mobile push queue full; dropped event %s", params.get("type"))
+            return
+        with self._lock:
+            if self._worker is None or not self._worker.is_alive():
+                self._worker = threading.Thread(target=self._run, name="mobile-push", daemon=True)
+                self._worker.start()
+
+    def _jobs(self, event: _Event) -> list[_Send]:
+        home, config_home, profile = event.home, event.config_home, event.profile
+        session_id, params = event.session_id, event.params
+        title = event.title.strip()[:80] or _session_title(home, session_id)
+        event_type = _EVENT_TYPES.get(str(params.get("type") or ""))
+        if not event_type:
+            return []
+        payload = params.get("payload") or {}
+        if event_type == "completion" and (
+                payload.get("status") == "error" or str(payload.get("text") or "").startswith("error: ")):
+            event_type = "error"
+        config = _configuration(config_home)
+        if (not config.get("enabled") or not str(config.get("firebase_project_id") or "").strip()
+                or not isinstance(config.get("allowed_application_ids"), list)):
+            return []
+        event_id = stamp_event_id(params)
+        if event_id is None:
+            return []
+        request_id = str((params.get("payload") or {}).get("request_id") or "").strip()
+        jobs = []
+        for row in _registrations(home, config_home, profile, event_type):
+            target = json.dumps({
+                "connection": row["connection"], "connection_identity": row["connection_identity"],
+                "profile": row["profile"], "session": session_id,
+            }, separators=(",", ":"))
+            data = {"schema_version": "1", "event_id": event_id, "event_type": event_type, "target": target}
+            if request_id:
+                data["request_id"] = request_id[:_MAX_ID]
+            label = {
+                "input_required": "Hermes needs your input",
+                "error": "Hermes needs attention",
+            }.get(event_type, "Hermes finished working")
+            shown_title = title.strip()[:80] if row["include_chat_title"] and title.strip() else "Hermes"
+            message = {
+                "token": row["fcm_token"],
+                "data": {**data, "title": shown_title, "body": label},
+                "android": {"priority": "HIGH"},
+            }
+            job = _Send(home, config_home, row["registration_id"], row["fcm_token"],
+                        str(config["firebase_project_id"]).strip(), message, event_id, event_type, title)
+            with self._lock:
+                key = (job.registration_id, event_id)
+                if key in self._seen:
+                    continue
+                self._seen[key] = time.monotonic()
+                if len(self._seen) > 1024:
+                    oldest = sorted(self._seen, key=self._seen.get)[:256]
+                    for item in oldest:
+                        self._seen.pop(item, None)
+            jobs.append(job)
+        return jobs
+
+    def _run(self) -> None:
+        while True:
+            event = self._queue.get()
+            try:
+                try:
+                    jobs = self._jobs(event)
+                except Exception:
+                    log.warning("mobile push event planning failed", exc_info=True)
+                    jobs = []
+                for job in jobs:
+                    try:
+                        self._send(job)
+                    except Exception:
+                        log.warning("mobile push send failed event=%s", job.event_id, exc_info=True)
+            finally:
+                self._queue.task_done()
+
+    def _send(self, job: _Send) -> None:
+        config = _configuration(job.config_home)
+        if self._current_registration(job, config) is None:
+            return
+        credentials = self._credential_loader(config)
+        from google.auth.transport.requests import Request
+        credentials.refresh(Request())
+        url = f"https://fcm.googleapis.com/v1/projects/{job.project_id}/messages:send"
+        response = None
+        with self._client_factory(timeout=10) as client:
+            for attempt in range(3):
+                current = self._current_registration(job, _configuration(job.config_home))
+                if current is None:
+                    return
+                job.message["data"]["title"] = (
+                    job.chat_title if current["include_chat_title"] and job.chat_title else "Hermes")
+                try:
+                    response = client.post(url, headers={"Authorization": f"Bearer {credentials.token}"},
+                                           json={"message": job.message})
+                except httpx.TransportError:
+                    if attempt == 2:
+                        raise
+                    time.sleep((attempt + 1) * 0.5)
+                    continue
+                if response.status_code not in (429, 500, 502, 503, 504):
+                    break
+                if attempt < 2:
+                    time.sleep((attempt + 1) * 0.5)
+        if response is not None and _is_unregistered(response):
+            with _database(job.home) as db:
+                db.execute("DELETE FROM registrations WHERE registration_id=? AND fcm_token=?",
+                           (job.registration_id, job.token))
+        elif response is not None:
+            response.raise_for_status()
+
+    @staticmethod
+    def _current_registration(job: _Send, config: dict):
+        if (not config.get("enabled")
+                or str(config.get("firebase_project_id") or "").strip() != job.project_id):
+            return None
+        preference = "completion" if job.event_type == "completion" else "attention"
+        with _database(job.home) as db:
+            row = db.execute(
+                f"SELECT fcm_token, application_id, include_chat_title, {preference} AS enabled "
+                "FROM registrations WHERE registration_id=?",
+                (job.registration_id,),
+            ).fetchone()
+        allowed = {str(item).strip() for item in config.get("allowed_application_ids", [])}
+        return row if (row and row["fcm_token"] == job.token and row["enabled"]
+                       and row["application_id"] in allowed) else None
+
+
+dispatcher = Dispatcher()
+
+
+def publish_event(home: Path, config_home: Path, profile: str, session_id: str,
+                  params: dict, title: str = "") -> None:
+    """Best-effort hook. Push failures never break the TUI event stream."""
+    try:
+        dispatcher.enqueue_event(home, config_home, profile, session_id, params, title)
+    except Exception:
+        log.debug("mobile push event hook failed", exc_info=True)
