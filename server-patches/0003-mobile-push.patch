@@ -0,0 +1,24 @@
+from tui_gateway import server
+
+
+def test_live_and_detached_terminal_events_use_stored_session_id(monkeypatch, tmp_path):
+    sent = []
+    monkeypatch.setattr("hermes_cli.mobile_push.publish_event", lambda *args: sent.append(args))
+    monkeypatch.setattr(server, "_hermes_home", tmp_path)
+    monkeypatch.setattr(server, "_current_profile_name", lambda: "work")
+    monkeypatch.setattr(server, "profile_name_for_home", lambda _home: "work")
+    class LiveTransport:
+        def write(self, _frame):
+            return True
+
+    try:
+        for sid, transport in (("detached", server._detached_ws_transport), ("live", LiveTransport())):
+            server._sessions[sid] = {
+                "transport": transport, "session_key": f"stored-{sid}", "profile_home": str(tmp_path)}
+            server._emit("message.complete", sid, {"text": "secret response"})
+    finally:
+        server._sessions.pop("detached", None)
+        server._sessions.pop("live", None)
+    assert len(sent) == 2
+    assert [call[3] for call in sent] == ["stored-detached", "stored-live"]
+    assert all(call[4]["payload"]["mobile_push_event_id"] for call in sent)
